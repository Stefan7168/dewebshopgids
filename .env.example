# Supabase project "dewebshopgids" (eu-central-1). Values: Supabase dashboard > Project settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://khljuorpncjrswgcayow.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Site-wide Basic Auth while the site is private. Leave empty to disable.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Comma-separated emails allowed into /admin.
ADMIN_EMAILS=

# Server only. Supabase > Project settings > API keys > service_role (secret). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Pipeline and agent jobs only (GitHub Actions or routines), never Vercel.
# Postgres connection string for the job's own login role, via the Supavisor pooler.
DATABASE_URL=
# Anthropic API key from the dewebshopgids workspace (monthly spend limit USD 150).
ANTHROPIC_API_KEY=
