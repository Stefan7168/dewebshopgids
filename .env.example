# Supabase project "dewebshopgids" (eu-central-1). Values: Supabase dashboard > Project settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://khljuorpncjrswgcayow.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Site-wide Basic Auth while the site is private. Leave empty to disable.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Comma-separated emails allowed into /admin.
ADMIN_EMAILS=

# Server only. Supabase > Project settings > API keys > service_role (secret). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Pipeline and agent jobs only (GitHub Actions or routines), never Vercel.
# Postgres connection string for the job's own login role, via the Supavisor pooler.
DATABASE_URL=
# Anthropic API key from the dewebshopgids workspace (monthly spend limit USD 150).
ANTHROPIC_API_KEY=

# Shared secret for POST /api/revalidate (Vercel and the pipeline). Generate with: openssl rand -hex 32
REVALIDATE_SECRET=
# GitHub Actions variable (not secret) for jobs that expire pages, e.g. https://dewebshopgids.nl/api/revalidate
REVALIDATE_URL=

# Email (Resend). Jobs: GitHub Environment `production` secrets. Site: Vercel env (sign-up emails).
RESEND_API_KEY=
# Sender, for example "De Webshopgids <info@dewebshopgids.nl>" once the domain is verified in Resend.
EMAIL_FROM=
# Resend segment that holds confirmed gids subscribers (added on confirmation); the Thursday
# Broadcast goes to it. Set it in Vercel and in the GitHub Environment `production`.
RESEND_GUIDE_SEGMENT_ID=
# Where owner alerts and the weekly digest go.
OWNER_EMAIL=

# /admin kill switch: fine-grained GitHub token for this repo with "Actions: read and write" only.
# Without it the kill switch still stops all agents (soft stop) and asks you to start the workflow by hand.
GITHUB_DISPATCH_TOKEN=
# Search Console import (nightly pipeline). JSON key of a Google service account that is a user on the property.
GSC_SERVICE_ACCOUNT_JSON=
# Defaults to sc-domain:dewebshopgids.nl
GSC_SITE_URL=

# Fixed Stripe Payment Link for the "Geverifieerd" badge (EUR 19/month), created once by Stefan. Not secret:
# a GitHub repository variable for the email sender. The sender adds ?client_reference_id=<shop id>.
STRIPE_BADGE_LINK=
